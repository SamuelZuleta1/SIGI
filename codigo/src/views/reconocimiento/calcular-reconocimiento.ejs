<%
  // HU-21 (DS-09; DA-09, DA-10, DA-51): el auxiliar ingresa el IBC y el sistema aplica los tramos de la regla del tipo.
  const dias = (n) => (n === 1 ? '1 día' : `${n} días`);
  // DA-50 y DA-51 (opción C): cada advertencia o nota va junto a su dato.
  const { incapacidad, resultado, aCargoDe, regla, advertenciaIbc } = reconocimiento;
  const cargo = { empresa: 'Empresa', eps: aCargoDe };
%>
<h1>Reconocimiento económico</h1>
<p class="sub">Ingrese el IBC y calcule cuánto paga la empresa y cuánto la <%= aCargoDe %>.</p>

<div class="formulario">
  <% if (calculado) { %>
    <p class="mensaje mensaje-ok entra" role="status">Cálculo guardado.<% if (resultado.tramitePension) { %> La incapacidad pasa a trámite de pensión desde el día 181.<% } %></p>
  <% } %>

  <dl class="resumen">
    <dt>Incapacidad</dt><dd>n.º <%= incapacidad.idIncapacidad %></dd>
    <dt>Colaborador</dt><dd><%= incapacidad.colaborador %></dd>
    <dt>Tipo</dt><dd><%= nombresTipo[incapacidad.tipo] %> · <%= incapacidad.entidad %></dd>
    <dt>Inicio</dt><dd><%= fechaBreve(incapacidad.fechaInicio) %> · <%= dias(incapacidad.diasIncapacidad) %><% if (incapacidad.diasPrevios) { %> · días <%= incapacidad.diasPrevios + 1 %> a <%= incapacidad.diasPrevios + incapacidad.diasIncapacidad %> del caso<% } %></dd>
  </dl>

  <% if (errores.estado) { %><p class="mensaje mensaje-error" role="alert"><%= errores.estado %></p><% } %>
  <% if (incapacidad.estado === 'pagada') { %>
    <p class="mensaje mensaje-info" role="status"><%= resultado ? 'Pagada: este es el cálculo guardado y ya no se puede cambiar.' : 'Pagada sin cálculo: su reconocimiento ya no se calcula.' %></p>
  <% } else { %>
  <form class="radicar" method="post" action="/incapacidades/<%= incapacidad.idIncapacidad %>/reconocimiento" novalidate data-un-envio>
    <div class="campo <%= errores.ibc ? 'invalido' : '' %>">
      <label for="ibc">IBC (pesos)</label>
      <div class="con-prefijo">
        <span aria-hidden="true">$</span>
        <input id="ibc" name="ibc" type="text" inputmode="decimal" maxlength="20" value="<%= valores.ibc ?? (incapacidad.ibc != null ? pesos(incapacidad.ibc).replace(/^\$\s?/, '') : '') %>" autocomplete="off" required data-pesos aria-describedby="<%= errores.ibc ? 'error-ibc' : advertenciaIbc ? 'ayuda-ibc advertencia-ibc' : 'ayuda-ibc' %>"<%- errores.ibc ? ' aria-invalid="true" autofocus' : '' %>>
      </div>
      <% if (errores.ibc) { %><span class="error" id="error-ibc"><%= errores.ibc %></span><% } else { %><span class="ayuda" id="ayuda-ibc">Ingreso base de cotización mensual, por ejemplo 2.800.000. El valor por día es el IBC ÷ 30.</span><% } %>
      <% if (advertenciaIbc && !errores.ibc) { %>
        <span class="advierte" id="advertencia-ibc"><%= textoAdvertenciaIbc(advertenciaIbc) %></span>
      <% } %>
    </div>
    <div class="acciones"><button class="boton" data-enviando="Calculando…"><%= resultado ? 'Calcular de nuevo' : 'Calcular' %></button></div>
  </form>
  <% } %>

  <% if (resultado) { %>
    <%- include('_resultado', { reconocimiento, calculado, idTitulo: 'titulo-resultado' }) %>
  <% } %>

  <div class="acciones">
    <a class="boton secundario" href="/reconocimiento">Otra incapacidad</a>
  </div>
</div>
