<%
  // HU-21 (DS-09): lista de incapacidades para calcular el reconocimiento económico.
  const dias = (n) => (n === 1 ? '1 día' : `${n} días`);
%>
<h1>Reconocimiento económico</h1>
<p class="sub">Calcule cuánto paga la empresa y cuánto la entidad (EPS o ARL). Abra una incapacidad e ingrese su IBC.</p>

<form class="filtros buscar-lista" method="get" action="/reconocimiento" role="search" novalidate>
  <div class="buscar">
    <div class="campo">
      <label for="q">N.º de incapacidad o colaborador</label>
      <input id="q" name="q" type="search" value="<%= busqueda %>" maxlength="60" placeholder="Por ejemplo: 104 o Restrepo" autocomplete="off" aria-describedby="ayuda-q">
    </div>
    <button class="boton">Buscar</button>
    <% if (busqueda) { %><a class="boton secundario" href="/reconocimiento">Quitar</a><% } %>
  </div>
  <span class="ayuda" id="ayuda-q">Solo cifras: el n.º exacto. Si no, parte del nombre del colaborador (con o sin tildes).</span>
</form>

<section class="resultado" aria-label="Incapacidades">
  <% if (locals.demasiados) { %>
    <div class="tabla-envuelta">
      <div class="vacio">
        <b>Hay demasiados colaboradores con «<%= busqueda %>».</b>
        <p>Escriba más del nombre o busque por el n.º de la incapacidad.</p>
      </div>
    </div>
  <% } else if (filas.length === 0 && busqueda) { %>
    <div class="tabla-envuelta">
      <div class="vacio">
        <b>Ninguna incapacidad coincide con «<%= busqueda %>».</b>
        <p>Revise el número o escriba otra parte del nombre del colaborador.</p>
      </div>
    </div>
  <% } else if (filas.length === 0) { %>
    <div class="tabla-envuelta">
      <div class="vacio">
        <b>Aún no hay incapacidades registradas.</b>
        <p>Cuando se registren, podrá calcular aquí su reconocimiento económico.</p>
      </div>
    </div>
  <% } else { %>
    <p class="cuenta-resultado">
      <span><b><%= filas.length %></b><% if (total > filas.length) { %> de <b><%= total %></b><% } %> <%= total === 1 ? 'incapacidad' : 'incapacidades' %><% if (busqueda) { %> que <%= total === 1 ? 'coincide' : 'coinciden' %> con «<%= busqueda %>»<% } %></span>
      <span><%= total > filas.length ? 'Las más recientes primero; afine la búsqueda para ver las demás' : 'Las más recientes primero' %></span>
    </p>
    <div class="tabla-envuelta">
      <table class="estados lista-reconocimiento">
        <caption class="oculto">Reconocimiento económico por incapacidad: escriba el IBC de la fila y calcule</caption>
        <thead>
          <tr><th scope="col">N.º</th><th scope="col">Colaborador</th><th scope="col">Entidad</th><th scope="col">Días</th><th scope="col">IBC</th><th scope="col" class="num">Empresa</th><th scope="col" class="num">Entidad</th><th scope="col">Cálculo</th></tr>
        </thead>
        <tbody>
          <% for (const f of filas) { const pagada = f.estado === 'pagada'; const calculada = f.ibc != null; %>
          <tr data-incapacidad="<%= f.idIncapacidad %>">
            <td><a href="/incapacidades/<%= f.idIncapacidad %>/reconocimiento" aria-label="Abrir la incapacidad <%= f.idIncapacidad %>"><%= f.idIncapacidad %></a></td>
            <td><%= f.colaborador %><small><%= nombresTipo[f.tipo] ?? f.tipo %></small></td>
            <td><%= f.entidad %></td>
            <td><%= f.diasIncapacidad %></td>
            <td class="celda-ibc">
              <% if (pagada) { %>
                <%# DA-53: una incapacidad pagada conserva su cálculo y ya no se cambia. %>
                <% if (calculada) { %><span class="cifra"><%= pesos(f.ibc) %></span><% } else { %><span class="tenue">—</span><% } %>
              <% } else { %>
                <form class="ibc-fila" method="post" action="/incapacidades/<%= f.idIncapacidad %>/reconocimiento" novalidate data-calculo-en-fila>
                  <div class="con-prefijo">
                    <span aria-hidden="true">$</span>
                    <input name="ibc" type="text" inputmode="decimal" maxlength="20" value="<%= calculada ? pesos(f.ibc).replace(/^\$\s?/, '') : '' %>" placeholder="IBC" autocomplete="off" required data-pesos aria-label="IBC de la incapacidad <%= f.idIncapacidad %> (pesos)">
                  </div>
                  <button class="boton pequeno secundario"><%= calculada ? 'Recalcular' : 'Calcular' %></button>
                  <span class="error" data-error role="alert" hidden></span>
                  <span class="advierte" data-advertencia hidden></span>
                </form>
              <% } %>
            </td>
            <td class="num cifra<%= calculada ? '' : ' tenue' %>" data-celda="empresa"><%= calculada ? pesos(f.valorEmpresa) : '—' %></td>
            <td class="num cifra<%= calculada ? '' : ' tenue' %>" data-celda="entidad"><%= calculada ? pesos(f.valorEPS) : '—' %></td>
            <td class="celda-calculo">
              <% if (pagada) { %><span class="chip pagada">Pagada</span>
              <% } else if (!calculada) { %><span class="tenue" data-estado>Sin calcular</span>
              <% } else if (f.tramitePension) { %><span class="chip por_vencer" data-estado>Trámite de pensión</span>
              <% } else { %><span class="chip al_dia" data-estado>Calculado</span><% } %>
              <a class="ver-tramos" href="/incapacidades/<%= f.idIncapacidad %>/reconocimiento"<%- calculada ? '' : ' hidden' %> aria-expanded="false" data-ver-tramos>Ver tramos</a>
            </td>
          </tr>
          <tr class="detalle-calculo" hidden data-detalle-de="<%= f.idIncapacidad %>"><td colspan="8"><div data-detalle></div></td></tr>
          <% } %>
        </tbody>
      </table>
    </div>
    <p class="oculto" id="aviso-calculo" role="status" aria-live="polite"></p>
  <% } %>
</section>
