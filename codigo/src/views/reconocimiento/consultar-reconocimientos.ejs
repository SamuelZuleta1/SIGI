<%
  // HU-21 (DS-09): lista de incapacidades para calcular el reconocimiento económico.
  const dias = (n) => (n === 1 ? '1 día' : `${n} días`);
%>
<h1>Reconocimiento económico</h1>
<p class="sub">Calcule cuánto paga la empresa y cuánto la EPS. Abra una incapacidad e ingrese su IBC.</p>

<section class="resultado" aria-label="Incapacidades">
  <% if (filas.length === 0) { %>
    <div class="tabla-envuelta">
      <div class="vacio">
        <b>Aún no hay incapacidades registradas.</b>
        <p>Cuando se registren, podrá calcular aquí su reconocimiento económico.</p>
      </div>
    </div>
  <% } else { %>
    <p class="cuenta-resultado">
      <span><b><%= filas.length %></b><% if (total > filas.length) { %> de <b><%= total %></b><% } %> <%= total === 1 ? 'incapacidad' : 'incapacidades' %></span>
      <span>Las más recientes primero</span>
    </p>
    <div class="tabla-envuelta">
      <table class="estados">
        <thead>
          <tr><th scope="col">N.º</th><th scope="col">Colaborador</th><th scope="col">Entidad</th><th scope="col">Días</th><th scope="col" class="num">Empresa</th><th scope="col" class="num">EPS</th><th scope="col">Cálculo</th></tr>
        </thead>
        <tbody>
          <% for (const f of filas) { %>
          <tr>
            <td><a href="/incapacidades/<%= f.idIncapacidad %>/reconocimiento" aria-label="Abrir la incapacidad <%= f.idIncapacidad %>"><%= f.idIncapacidad %></a></td>
            <td><%= f.colaborador %><small><%= nombresTipo[f.tipo] ?? f.tipo %></small></td>
            <td><%= f.entidad %></td>
            <td><%= f.diasIncapacidad %></td>
            <% if (f.ibc != null) { %>
              <td class="num cifra"><%= pesos(f.valorEmpresa) %></td>
              <td class="num cifra"><%= pesos(f.valorEPS) %></td>
              <td><% if (f.tramitePension) { %><span class="chip por_vencer">Trámite de pensión</span><% } else { %><span class="chip al_dia">Calculado</span><% } %></td>
            <% } else { %>
              <td class="num tenue">—</td><td class="num tenue">—</td>
              <td><span class="tenue">Sin calcular</span></td>
            <% } %>
          </tr>
          <% } %>
        </tbody>
      </table>
    </div>
  <% } %>
</section>
