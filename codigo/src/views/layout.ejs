<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title><%= titulo %> · SIGI</title>
  <link rel="stylesheet" href="/css/sigi.css">
</head>
<body>
  <a class="saltar" href="#contenido">Saltar al contenido</a>
  <header class="cabecera">
    <a class="marca" href="/">SIGI</a>
    <span class="marca-detalle">Sistema Integral de Gestión de Incapacidades</span>
    <% if (usuario) { %>
      <span class="sesion"><%= usuario.correo %></span>
    <% } %>
  </header>
  <main id="contenido" class="contenido">
    <%- cuerpo %>
  </main>
</body>
</html>
