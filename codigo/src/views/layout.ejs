<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title><%= titulo %> · SIGI</title>
  <link rel="preload" href="/fonts/inter-latin-wght-normal.woff2" as="font" type="font/woff2" crossorigin>
  <link rel="stylesheet" href="/css/sigi.css">
  <script src="/js/sigi.js" defer></script>
</head>
<% if (usuario) { %>
<body class="con-marco">
  <a class="saltar" href="#contenido">Saltar al contenido</a>
  <nav class="lateral" aria-label="Módulos">
    <a class="marca" href="/">SIGI</a>
    <ul class="menu">
      <li>
        <a href="/" <%- ruta === '/' ? 'aria-current="page"' : '' %>>
          <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 11l8-7 8 7v9h-5v-6H9v6H4z"/></svg>
          Inicio
        </a>
      </li>
      <% if (puede('registrarIncapacidad')) { %>
      <li>
        <a href="/incapacidades/nueva" <%- ruta === '/incapacidades/nueva' ? 'aria-current="page"' : '' %>>
          <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M14 3H6v18h12V7zM14 3v4h4M12 11v6M9 14h6"/></svg>
          Registrar incapacidad
        </a>
      </li>
      <% } %>
      <% if (puede('registrarDocumentos')) { %>
      <li>
        <a href="/documentos" <%- ruta === '/documentos' || /^\/incapacidades\/\d+\/documentos$/.test(ruta) ? 'aria-current="page"' : '' %>>
          <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 16V5M8 9l4-4 4 4M5 15v4h14v-4"/></svg>
          Registrar documentos
        </a>
      </li>
      <% } %>
      <% if (puede('verificarDocumentacion')) { %>
      <li>
        <a href="/verificacion" <%- ruta === '/verificacion' || /^\/incapacidades\/\d+\/verificacion$/.test(ruta) ? 'aria-current="page"' : '' %>>
          <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M9 5H6v16h12V5h-3M9 3h6v4H9zM9 14l2 2 4-4"/></svg>
          Verificar documentación
        </a>
      </li>
      <% } %>
      <% if (puede('prepararRadicacion')) { %>
      <li>
        <a href="/radicacion" <%- ruta === '/radicacion' || /^\/incapacidades\/\d+\/radicacion$/.test(ruta) ? 'aria-current="page"' : '' %>>
          <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 12l16-8-6 16-2.5-6.5zM11.5 13.5L20 4"/></svg>
          Radicación
        </a>
      </li>
      <% } %>
      <% if (puede('registrarCobrada')) { %>
      <li>
        <a href="/cobro" <%- ruta === '/cobro' || /^\/incapacidades\/\d+\/cobro$/.test(ruta) ? 'aria-current="page"' : '' %>>
          <svg viewBox="0 0 24 24" aria-hidden="true"><rect x="3.5" y="6" width="17" height="12" rx="1.5"/><path d="M3.5 10h17M7 14.5h3"/></svg>
          Cobro
        </a>
      </li>
      <% } %>
      <% if (puede('consultarPendientesDePago')) { %>
      <li>
        <a href="/seguimiento" <%- ruta === '/seguimiento' || /^\/incapacidades\/\d+\/(seguimiento|requerimientos)$/.test(ruta) ? 'aria-current="page"' : '' %>>
          <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 5h16M4 12h10M4 19h7"/><circle cx="17.5" cy="16.5" r="3.5"/><path d="M17.5 15v1.7l1.1.8"/></svg>
          Seguimiento
        </a>
      </li>
      <% } %>
      <% if (puede('consultarEstados')) { %>
      <li>
        <a href="/estados" <%- ruta === '/estados' ? 'aria-current="page"' : '' %>>
          <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 6h16M4 12h16M4 18h10M18 16l2 2-2 2"/></svg>
          Consultar estados
        </a>
      </li>
      <% } %>
      <% if (puede('consultarAlertas')) { %>
      <li>
        <a href="/alertas" <%- ruta === '/alertas' ? 'aria-current="page"' : '' %>>
          <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M6 16V11a6 6 0 0 1 12 0v5l2 2H4zM10 21h4"/></svg>
          Alertas de plazos
        </a>
      </li>
      <% } %>
      <% if (puede('registrarReemplazo')) { %>
      <li>
        <a href="/reemplazo" <%- ruta === '/reemplazo' || /^\/incapacidades\/\d+\/reemplazo$/.test(ruta) ? 'aria-current="page"' : '' %>>
          <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 8h13M14 5l3 3-3 3M20 16H7M10 13l-3 3 3 3"/></svg>
          Registrar reemplazo
        </a>
      </li>
      <% } %>
    </ul>
    <div class="cuenta">
      <p class="cuenta-correo"><%= usuario.correo %></p>
      <p class="cuenta-rol"><%= nombreRol %></p>
      <form method="post" action="/cerrar-sesion">
        <button class="enlace-lateral">
          <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M15 4h4v16h-4M10 8l-4 4 4 4M6 12h9"/></svg>
          Cerrar sesión
        </button>
      </form>
    </div>
  </nav>
  <main id="contenido" class="contenido" tabindex="-1">
    <%- cuerpo %>
  </main>
</body>
<% } else { %>
<body class="sin-marco">
  <main id="contenido" class="acceso">
    <%- cuerpo %>
  </main>
</body>
<% } %>
</html>
