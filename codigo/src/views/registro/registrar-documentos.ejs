<h1>Registrar documentos</h1>
<% if (!incapacidad) { %>
  <p class="sub">Escriba el número de la incapacidad a la que pertenecen los documentos.</p>
  <form class="formulario" method="get" action="/documentos" novalidate>
    <div class="buscar">
      <div class="campo <%= errorNumero ? 'invalido' : '' %>">
        <label for="incapacidad">Incapacidad n.º</label>
        <input id="incapacidad" name="incapacidad" type="text" inputmode="numeric" pattern="[0-9]*" value="<%= numero %>" maxlength="18" autocomplete="off" required autofocus<%- errorNumero ? ' aria-invalid="true" aria-describedby="error-incapacidad"' : '' %>>
      </div>
      <button class="boton">Continuar</button>
    </div>
    <% if (errorNumero) { %>
      <p class="mensaje mensaje-error" id="error-incapacidad" role="alert"><%= errorNumero %> Revise el número que recibió al registrarla.</p>
    <% } else { %>
      <p class="ayuda">Es el número que SIGI mostró al registrar la incapacidad.</p>
    <% } %>
  </form>
<% } else { %>
  <p class="sub">Documentos que entregó el colaborador. PDF, JPG o PNG, máximo 10 MB cada uno.</p>

  <% if (registrados) { %>
    <p class="mensaje mensaje-ok" role="status">
      <%= registrados === 1 ? 'Se registró 1 documento' : `Se registraron ${registrados} documentos` %> en la incapacidad n.º <strong><%= incapacidad.idIncapacidad %></strong>.
      <% if (usuario.rol === 'auxiliar') { %>El original en físico quedó como pendiente.<% } else if (avisoEnviado) { %>Se avisó al auxiliar por correo.<% } %>
    </p>
    <% if (usuario.rol !== 'auxiliar' && !avisoEnviado) { %>
      <p class="mensaje mensaje-aviso" role="alert">No se pudo enviar el correo de aviso al auxiliar. Los documentos sí quedaron guardados: avísele por otro medio.</p>
    <% } %>
  <% } %>
  <% if (Object.keys(errores).length > 0) { %>
    <p class="mensaje mensaje-error" role="alert">No se registró ningún documento. <%= errores.documentos ?? 'Revise las filas marcadas y adjunte de nuevo los archivos.' %></p>
  <% } %>

  <form class="formulario" method="post" action="/incapacidades/<%= incapacidad.idIncapacidad %>/documentos" enctype="multipart/form-data" novalidate data-subida-directa>
    <dl class="resumen">
      <dt>Incapacidad</dt><dd>n.º <%= incapacidad.idIncapacidad %></dd>
      <dt>Colaborador</dt><dd><%= incapacidad.colaborador %></dd>
      <dt>Tipo</dt><dd><%= nombresTipo[incapacidad.tipo] %> · <%= incapacidad.entidad %></dd>
      <dt>Inicio</dt><dd><%= incapacidad.fechaInicio %> · <%= incapacidad.diasIncapacidad %> <%= incapacidad.diasIncapacidad === 1 ? 'día' : 'días' %></dd>
      <% if (incapacidad.originalPendiente) { %><dt>Original</dt><dd>Pendiente en físico</dd><% } %>
    </dl>

    <%
      // Lo que ya está registrado va arriba (con «Ver»); abajo solo se agregan los tipos que faltan.
      const porTipo = {};
      for (const d of incapacidad.documentos ?? []) (porTipo[d.tipo] ??= []).push(d);
      const registradosTipos = Object.keys(tipos).filter((tipo) => porTipo[tipo]);
      const faltantesTipos = Object.keys(tipos).filter((tipo) => !porTipo[tipo]);
      const errorEnRegistrados = registradosTipos.some((tipo) => errores[tipo]);
    %>
    <% if (registradosTipos.length > 0) { %>
      <section class="ya-registrados" aria-labelledby="titulo-registrados">
        <h2 id="titulo-registrados">Ya registrados <span class="tenue">· <%= registradosTipos.length %> de <%= Object.keys(tipos).length %> tipos</span></h2>
        <div class="lista-tipos">
          <% for (const tipo of registradosTipos) { const docs = porTipo[tipo]; %>
            <div class="fila registrada">
              <span class="nombre-tipo"><%= tipos[tipo] %></span>
              <div class="registrado">
                <span class="estado recibido"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M5 12.5l4.5 4.5L19 7.5"/></svg>Recibido<% if (docs[0].creadoEn) { %> · <%= fechaRecibido(docs[0].creadoEn) %><% } %><% if (docs.length > 1) { %> · <%= docs.length %> archivos<% } %></span>
                <% if (puedeVer(tipo)) { %>
                  <span class="enlaces"><% docs.forEach((d, i) => { %><a class="ver" href="/documentos/<%= d.idDocumento %>/archivo" target="_blank" rel="noopener"><%= docs.length > 1 ? `Ver ${i + 1}` : 'Ver' %></a><% }) %></span>
                <% } else { %>
                  <span class="tenue">Lo abre el auxiliar</span>
                <% } %>
              </div>
            </div>
          <% } %>
        </div>
      </section>
    <% } %>

    <% if (faltantesTipos.length > 0) { %>
      <fieldset>
        <legend><%= registradosTipos.length > 0 ? 'Agregar documentos' : 'Documentos' %></legend>
        <div class="lista-tipos" data-soltar-archivos>
          <% for (const tipo of faltantesTipos) { %><%- include('_fila-archivo', { tipo, tipos, errores }) %><% } %>
        </div>
        <p class="ayuda">Elija el archivo o arrástrelo a la fila de su tipo. Adjunte solo los que recibió.</p>
      </fieldset>
    <% } %>

    <% if (registradosTipos.length > 0) { %>
      <details class="otro-del-mismo-tipo"<%- errorEnRegistrados ? ' open' : '' %>>
        <summary>Agregar otro archivo de un tipo ya registrado</summary>
        <div class="lista-tipos" data-soltar-archivos>
          <% for (const tipo of registradosTipos) { %><%- include('_fila-archivo', { tipo, tipos, errores }) %><% } %>
        </div>
      </details>
    <% } %>

    <div class="acciones">
      <button class="boton">Registrar documentos</button>
      <a class="boton secundario" href="/documentos">Otra incapacidad</a>
    </div>
  </form>
<% } %>
