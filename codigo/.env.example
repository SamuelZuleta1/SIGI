# SIGI — variables de entorno. Copiar a .env y completar. El archivo .env NO se sube al repositorio.

# Servidor web
PORT=3000

# Supabase (local: valores de `supabase status`)
SUPABASE_URL=
# Clave de servidor. NUNCA debe llegar al navegador.
SUPABASE_SERVICE_ROLE_KEY=
# Clave pública: solo para iniciar sesión y para las pruebas de RLS.
SUPABASE_ANON_KEY=

# Correo SMTP (desarrollo y demostración: Mailpit de Supabase local, puerto 54325)
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
# Bandeja web de Mailpit (solo para las pruebas de integración)
MAILPIT_URL=

# Destinatarios de las notificaciones por área
CORREO_AUXILIAR=
CORREO_COORDINACION=
CORREO_CONTABILIDAD=
CORREO_CARTERA=
CORREO_SGSST=
CORREO_GESTION_DOCUMENTAL=

# Contraseña de los 10 usuarios de demostración (DA-02)
DEMO_PASSWORD=
