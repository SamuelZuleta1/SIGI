# SIGI — variables de entorno. Copiar a .env y completar. El archivo .env NO se sube al repositorio.

# Servidor web
PORT=3000

# Supabase en la nube (proyecto vinculado; ver README). Panel → Project Settings → API.
SUPABASE_URL=
# Clave de servidor. NUNCA debe llegar al navegador.
SUPABASE_SERVICE_ROLE_KEY=
# Clave pública: solo para iniciar sesión y para las pruebas de RLS.
SUPABASE_ANON_KEY=

# Correo SMTP (servidor institucional; en desarrollo puede usarse Mailpit en el puerto 54325)
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
# Bandeja web de Mailpit (solo para las pruebas de integración)
MAILPIT_URL=

# Destinatarios de las notificaciones por área
CORREO_AUXILIAR=
CORREO_COORDINACION=
CORREO_CONTABILIDAD=
CORREO_CARTERA=
CORREO_SGSST=
CORREO_GESTION_DOCUMENTAL=

# Contraseña de los 10 usuarios de demostración (DA-02)
DEMO_PASSWORD=

# Supabase CLI (solo para `npm run db:migrar` y `npm run db:estado`)
# Token personal con alcance limitado a este proyecto y contraseña de la base de datos.
SUPABASE_ACCESS_TOKEN=
SUPABASE_DB_PASSWORD=
