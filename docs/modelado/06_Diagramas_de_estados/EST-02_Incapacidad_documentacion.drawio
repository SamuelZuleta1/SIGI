<mxfile host="app.diagrams.net"><diagram name="EST-02 – Diagrama de estados: Incapacidad, documentación" id="ad"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1900" pageHeight="930" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="n2" value="" style="ellipse;html=1;fillColor=#000000;strokeColor=#000000;" vertex="1" parent="1"><mxGeometry x="208.0" y="38.0" width="24" height="24" as="geometry"/></mxCell><mxCell id="n3" value="&lt;div style='text-align:center'&gt;&lt;b&gt;Registrada (sin documentos)&lt;/b&gt;&lt;/div&gt;&lt;hr size='1'&gt;documentos = ninguno" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;align=left;verticalAlign=top;spacingLeft=8;spacingRight=8;spacingTop=4;fillColor=#FFFFFF;strokeColor=#000000;fontSize=11;" vertex="1" parent="1"><mxGeometry x="100" y="110" width="240" height="130" as="geometry"/></mxCell><mxCell id="n4" value="&lt;div style='text-align:center'&gt;&lt;b&gt;Documentos registrados&lt;/b&gt;&lt;/div&gt;&lt;hr size='1'&gt;originalPendiente = verdadero si los documentos llegaron por correo electrónico" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;align=left;verticalAlign=top;spacingLeft=8;spacingRight=8;spacingTop=4;fillColor=#FFFFFF;strokeColor=#000000;fontSize=11;" vertex="1" parent="1"><mxGeometry x="700" y="110" width="300" height="130" as="geometry"/></mxCell><mxCell id="n5" value="&lt;div style='text-align:center'&gt;&lt;b&gt;En verificación&lt;/b&gt;&lt;/div&gt;&lt;hr size='1'&gt;documentacionCompleta = por determinar&lt;hr size='1'&gt;do / compararConRequisitos()" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;align=left;verticalAlign=top;spacingLeft=8;spacingRight=8;spacingTop=4;fillColor=#FFFFFF;strokeColor=#000000;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1340" y="110" width="300" height="140" as="geometry"/></mxCell><mxCell id="n6" value="&lt;div style='text-align:center'&gt;&