<mxfile host="app.diagrams.net"><diagram name="EST-01 – Diagrama de estados: Incapacidad, ciclo de cobro" id="ad"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1780" pageHeight="860" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="n2" value="" style="ellipse;html=1;fillColor=#000000;strokeColor=#000000;" vertex="1" parent="1"><mxGeometry x="208.0" y="38.0" width="24" height="24" as="geometry"/></mxCell><mxCell id="n3" value="&lt;div style='text-align:center'&gt;&lt;b&gt;Registrada (sin transcribir)&lt;/b&gt;&lt;/div&gt;&lt;hr size='1'&gt;estado = sin valor" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;align=left;verticalAlign=top;spacingLeft=8;spacingRight=8;spacingTop=4;fillColor=#FFFFFF;strokeColor=#000000;fontSize=11;" vertex="1" parent="1"><mxGeometry x="100" y="130" width="240" height="100" as="geometry"/></mxCell><mxCell id="n4" value="&lt;div style='text-align:center'&gt;&lt;b&gt;Transcrita&lt;/b&gt;&lt;/div&gt;&lt;hr size='1'&gt;estado = transcrita" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;align=left;verticalAlign=top;spacingLeft=8;spacingRight=8;spacingTop=4;fillColor=#FFFFFF;strokeColor=#000000;fontSize=11;" vertex="1" parent="1"><mxGeometry x="660" y="130" width="260" height="100" as="geometry"/></mxCell><mxCell id="n5" value="&lt;div style='text-align:center'&gt;&lt;b&gt;Cobrada&lt;/b&gt;&lt;/div&gt;&lt;hr size='1'&gt;estado = cobrada&lt;br&gt;tiempoPago&lt;hr size='1'&gt;registrarSeguimiento(evidencia) [el pago supera el tiempo prometido] / guardarSeguimiento(evidencia) ^notificarRetraso(Coordinación)&lt;br&gt;registrarSeguimiento(evidencia) [el pago no supera el tiempo prometido] / guardarSeguimiento(evidencia)&lt;br&gt;registrarAcuerdo(acuerdo) / guardarAcuerdo(acuerdo)&lt;br&gt;registrarRequerimiento(fundamentos) / guardarRequerimiento(fundamentos)&lt;br&gt;trasladarACartera(idIncapacidad, motivo) / guardarTraslado(motivo) ^notificarTraslado(Cartera y Jurídica)&lt;br&gt;registrarDecision(decision) / guardarDecision(decision)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;align=left;verticalAlign=top;spacingLeft=8;spacingRight=8;spacingTop=4;fillColor=#FFFFFF;strokeColor=#000000;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1240" y="110" width="480" height="270" as="geometry"/></mxCell><mxCell id="n6" value="&lt;div style='text-align:center'&gt;&lt;b&gt;Rechazada&lt;/b&gt;&lt;/div&gt;&lt;hr size='1'&gt;estado = rechazada&lt;br&gt;causalRechazo" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;align=left;verticalAlign=top;spacingLeft=8;spacingRight=8;spacingTop=4;fillColor=#FFFFFF;strokeColor=#000000;fontSize=11;" vertex="1" parent="1"><mxGeometry x="660" y="420" width="260" height="110" as="geometry"/></mxCell><mxCell id="n7" value="&lt;div style='text-align:center'&gt;&lt;b&gt;Pagada&lt;/b&gt;&lt;/div&gt;&lt;hr size='1'&gt;estado = pagada&lt;hr size='1'&gt;archivarIncapacidad(idIncapacidad) [el pago no está identificado] / pagoNoIdentificado&lt;br&gt;archivarIncapacidad(idIncapacidad) [el pago está identificado y conciliado, y tiene historia clínica o epicrisis] / eliminarEpicrisis ^enviarParaArchivo(Gestión Documental)&lt;br&gt;archivarIncapacidad(idIncapacidad) [el pago está identificado y conciliado, y no tiene historia clínica ni epicrisis] / ^enviarParaArchivo(Gestión Documental)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;align=left;verticalAlign=top;spacingLeft=8;spacingRight=8;spacingTop=4;fillColor=#FFFFFF;strokeColor=#000000;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1240" y="520" width="480" height="190" as="geometry"/></mxCell><mxCell id="n8" value="" style="ellipse;html=1;shape=endState;fillColor=#000000;strokeColor=#000000;" vertex="1" parent="1"><mxGeometry x="1465.0" y="785.0" width="30" height="30" as="geometry"/></mxCell><mxCell id="n9" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=open;endFill=0;strokeColor=#000000;jumpStyle=arc;jumpSize=8;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="n2" target="n3"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="n10" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=open;endFill=0;strokeColor=#000000;jumpStyle=arc;jumpSize=8;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="n3" target="n4"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="n11" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=open;endFill=0;strokeColor=#000000;jumpStyle=arc;jumpSize=8;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.25925925925925924;entryDx=0;entryDy=0;" edge="1" parent="1" source="n4" target="n5"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="n12" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=open;endFill=0;strokeColor=#000000;jumpStyle=arc;jumpSize=8;exitX=0.75;exitY=1;exitDx=0;exitDy=0;entryX=0.75;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="n4" target="n6"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="n13" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=open;endFill=0;strokeColor=#000000;jumpStyle=arc;jumpSize=8;exitX=0.25;exitY=0;exitDx=0;exitDy=0;entryX=0.25;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="1" source="n6" target="n4"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="n14" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=open;endFill=0;strokeColor=#000000;jumpStyle=arc;jumpSize=8;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="n5" target="n7"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="n15" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=open;